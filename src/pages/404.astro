---
import "@/styles/global.css";
// Static 404 served by Cloudflare Pages with a real 404 status for unknown
// URLs (replaces the SPA fallback that returned 200 + a client redirect).
// Bilingual on one page: locale of an unknown URL can't be known statically.
---

<html lang="nl" class="w-full h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404: Pagina niet gevonden | Russo NV</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
  </head>
  <body class="w-full h-full bg-background">
    <main class="min-h-screen flex flex-col items-center justify-center gap-6 px-6 text-center">
      <p class="font-heading text-7xl md:text-9xl text-primary">404</p>
      <h1 class="font-heading text-2xl md:text-4xl text-foreground uppercase">
        Pagina niet gevonden
      </h1>
      <p class="font-paragraph text-base text-foreground/70 max-w-prose">
        Deze pagina bestaat niet (meer). / This page does not exist.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/"
          class="font-paragraph font-bold uppercase tracking-wider text-sm bg-primary text-white px-6 py-3 hover:opacity-90"
        >
          Naar de homepage
        </a>
        <a
          href="/en"
          class="font-paragraph font-bold uppercase tracking-wider text-sm border border-foreground/20 text-foreground px-6 py-3 hover:border-primary"
        >
          Go to homepage
        </a>
      </div>
    </main>
  </body>
</html>
