---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import { serializeJsonLd } from "@/lib/json-ld";
import { ARTICLES, findArticle, type ArticleBlock } from "@/data/articles";
import "@/styles/global.css";

export function getStaticPaths() {
  const routes = ['', 'services', 'services/industriele-schilderwerken', 'services/tankcoating', 'services/industrieel-stralen', 'industries', 'projects', 'safety', 'about', 'contact', 'insights', 'privacy', 'terms'];
  const articleRoutes = ARTICLES.map((a) => `insights/${a.slug}`);
  return [...routes, ...articleRoutes].flatMap((r) => [
    { params: { slug: r === '' ? undefined : r } },
    { params: { slug: r === '' ? 'en' : `en/${r}` } },
  ]);
}

const SITE_URL = 'https://www.russonv.com';
const DEFAULT_OG_IMAGE = '/images/home-hero.jpg';

import { PAGE_META, type Locale } from '@/lib/page-meta';

const rawPath = Astro.url.pathname;
// With build format:"file" the build-time pathname carries a ".html" suffix
// (e.g. /services/industriele-schilderwerken.html); the public URL never does.
const trimmed = rawPath.length > 1 ? rawPath.replace(/\.html$/, '').replace(/\/$/, '') : rawPath;

const isEN = trimmed === '/en' || trimmed.startsWith('/en/');
const locale: Locale = isEN ? 'EN' : 'NL';
const basePath = (() => {
  if (trimmed === '/en' || trimmed === '/en/') return '/';
  if (trimmed.startsWith('/en/')) return trimmed.slice(3);
  return trimmed;
})();

const articleSlug = basePath.startsWith('/insights/') ? basePath.slice('/insights/'.length) : null;
const article = articleSlug ? findArticle(articleSlug) : null;

const meta = PAGE_META[basePath] ?? PAGE_META['/'];
const localeMeta = article
  ? { title: article[locale].metaTitle, description: article[locale].description, image: article.heroImage }
  : meta[locale];
const isNoindex = article ? false : !!meta.noindex;
const ogType = article ? 'article' : 'website';

const nlPath = basePath === '/' ? '/' : basePath;
const enPath = basePath === '/' ? '/en' : `/en${basePath}`;

const canonical = `${SITE_URL}${locale === 'EN' ? enPath : nlPath}`;
const nlUrl = `${SITE_URL}${nlPath}`;
const enUrl = `${SITE_URL}${enPath}`;

const ogImage = `${SITE_URL}${localeMeta.image ?? DEFAULT_OG_IMAGE}`;
const htmlLang = locale === 'EN' ? 'en' : 'nl';
const ogLocale = locale === 'EN' ? 'en_BE' : 'nl_BE';
const ogLocaleAlt = locale === 'EN' ? 'nl_BE' : 'en_BE';

const BREADCRUMB_LABELS: Record<string, { NL: string; EN: string }> = {
  '/':           { NL: 'Home',           EN: 'Home' },
  '/services':   { NL: 'Diensten',       EN: 'Services' },
  '/services/industriele-schilderwerken': { NL: 'Industriële schilderwerken', EN: 'Industrial painting' },
  '/services/tankcoating': { NL: 'Tankcoating & tank lining', EN: 'Tank coating & lining' },
  '/services/industrieel-stralen': { NL: 'Industrieel stralen', EN: 'Industrial blasting' },
  '/industries': { NL: 'Sectoren',       EN: 'Industries' },
  '/projects':   { NL: 'Projecten',      EN: 'Projects' },
  '/safety':     { NL: 'Veiligheid',     EN: 'Safety' },
  '/about':      { NL: 'Over ons',       EN: 'About' },
  '/contact':    { NL: 'Contact',        EN: 'Contact' },
  '/insights':   { NL: 'Kenniscentrum',  EN: 'Insights' },
  '/privacy':    { NL: 'Privacy',        EN: 'Privacy' },
  '/terms':      { NL: 'Voorwaarden',    EN: 'Terms' },
};

const homeLabel = locale === 'EN' ? 'Home' : 'Home';
const homeUrl = locale === 'EN' ? `${SITE_URL}/en` : `${SITE_URL}/`;

const insightsLabel = locale === 'EN' ? 'Insights' : 'Kenniscentrum';
const insightsUrl = locale === 'EN' ? `${SITE_URL}/en/insights` : `${SITE_URL}/insights`;
const isServiceSub = basePath.startsWith('/services/');
const servicesLabel = locale === 'EN' ? 'Services' : 'Diensten';
const servicesUrl = locale === 'EN' ? `${SITE_URL}/en/services` : `${SITE_URL}/services`;

const breadcrumbSchema = basePath === '/' ? null : article ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: insightsLabel, item: insightsUrl },
    { '@type': 'ListItem', position: 3, name: article[locale].title, item: canonical },
  ],
} : isServiceSub ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: servicesLabel, item: servicesUrl },
    { '@type': 'ListItem', position: 3, name: BREADCRUMB_LABELS[basePath]?.[locale] ?? localeMeta.title, item: canonical },
  ],
} : {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: BREADCRUMB_LABELS[basePath]?.[locale] ?? localeMeta.title, item: canonical },
  ],
};

const websiteSchema = basePath === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Russo NV',
  alternateName: 'Russo Industriële Coatings',
  url: SITE_URL,
  inLanguage: ['nl-BE', 'en'],
  publisher: { '@id': `${SITE_URL}/#organization` },
} : null;

const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  headline: article[locale].title,
  description: article[locale].description,
  image: ogImage,
  datePublished: article.date,
  dateModified: article.updated ?? article.date,
  inLanguage: locale === 'EN' ? 'en' : 'nl-BE',
  author: {
    '@type': 'Person',
    name: article.author,
    ...(article.authorRole ? { jobTitle: article.authorRole[locale] } : {}),
    ...(article.authorImage ? { image: `${SITE_URL}${article.authorImage}` } : {}),
    worksFor: { '@type': 'Organization', name: 'Russo NV', url: SITE_URL },
    knowsAbout: ['Industrial coatings', 'Surface preparation', 'Abrasive blasting', 'Corrosion protection'],
    ...(article.authorUrl ? { sameAs: [article.authorUrl] } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Russo NV',
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/logo.png` },
  },
  keywords: article.keywords[locale].join(', '),
} : null;

// FAQ rich result: build FAQPage schema from the article's faq block (if any).
const faqItems = article
  ? (article[locale].body.find((b) => b.type === 'faq') as Extract<ArticleBlock, { type: 'faq' }> | undefined)?.items
  : undefined;
const faqSchema = faqItems && faqItems.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
} : null;

// OG/Twitter image alt + dimensions (read real dims at build; degrade gracefully).
const ogImageAlt = article ? article.heroAlt[locale] : localeMeta.title;
let ogImageDims: { width: number; height: number } | null = null;
try {
  const sharp = (await import('sharp')).default;
  const rel = (localeMeta.image ?? DEFAULT_OG_IMAGE).replace(/^\//, '');
  const md = await sharp(`public/${rel}`).metadata();
  if (md.width && md.height) ogImageDims = { width: md.width, height: md.height };
} catch {}
---

<html lang={htmlLang} class="w-full h-full">
  <head>
    <Head />
    <title>{localeMeta.title}</title>
    <meta name="description" content={localeMeta.description} />
    {/* LCP: fetch this route's hero image at highest priority, before the
        browser discovers it inside the rendered body. */}
    {localeMeta.image && (
      <link rel="preload" as="image" href={localeMeta.image} fetchpriority="high" />
    )}
    <link rel="canonical" href={canonical} />
    {isNoindex && <meta name="robots" content="noindex, follow" />}

    <link rel="alternate" hreflang="nl-be" href={nlUrl} />
    <link rel="alternate" hreflang="nl" href={nlUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={nlUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Russo NV" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={localeMeta.title} />
    <meta property="og:description" content={localeMeta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageDims && <meta property="og:image:width" content={String(ogImageDims.width)} />}
    {ogImageDims && <meta property="og:image:height" content={String(ogImageDims.height)} />}
    {article && <meta property="article:published_time" content={article.date} />}
    {article && <meta property="article:modified_time" content={article.updated ?? article.date} />}
    {article && <meta property="article:section" content={article[locale].category} />}
    {article && article.keywords[locale].map((k) => <meta property="article:tag" content={k} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={localeMeta.title} />
    <meta name="twitter:description" content={localeMeta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {(article || basePath === '/insights') && (
      <link rel="alternate" type="application/rss+xml" title="Russo NV Kenniscentrum" href={`${SITE_URL}/insights/rss.xml`} />
    )}

    {breadcrumbSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(breadcrumbSchema)}
      />
    )}
    {websiteSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(websiteSchema)}
      />
    )}
    {articleSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(articleSchema)}
      />
    )}
    {faqSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(faqSchema)}
      />
    )}
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:load initialPath={trimmed} />
    </div>
  </body>
</html>
