---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import { serializeJsonLd } from "@/lib/json-ld";
import { ARTICLES, findArticle, articleContent, localeText, type ArticleBlock } from "@/data/articles";
import { CASE_STUDIES } from "@/data/case-studies";
import "@/styles/global.css";

export function getStaticPaths() {
  const routes = ['', 'services', 'services/industriele-schilderwerken', 'services/tankcoating', 'services/industrieel-stralen', 'services/corrosiebescherming', 'industries', 'projects', 'safety', 'about', 'contact', 'insights', 'privacy', 'terms'];
  const articleRoutes = ARTICLES.map((a) => `insights/${a.slug}`);
  const caseStudyRoutes = CASE_STUDIES.map((c) => `projects/${c.slug}`);
  // French pages exist for every base page, and for articles and case studies once they have FR content.
  const frRoutes = [...routes, ...ARTICLES.filter((a) => a.FR).map((a) => `insights/${a.slug}`), ...CASE_STUDIES.filter((c) => c.FR).map((c) => `projects/${c.slug}`)];
  return [
    ...[...routes, ...articleRoutes, ...caseStudyRoutes].flatMap((r) => [
      { params: { slug: r === '' ? undefined : r } },
      { params: { slug: r === '' ? 'en' : `en/${r}` } },
    ]),
    ...frRoutes.map((r) => ({ params: { slug: r === '' ? 'fr' : `fr/${r}` } })),
  ];
}

const SITE_URL = 'https://www.russonv.com';
const DEFAULT_OG_IMAGE = '/images/home-hero.jpg';

import { PAGE_META, type Locale } from '@/lib/page-meta';

const rawPath = Astro.url.pathname;
// With build format:"file" the build-time pathname carries a ".html" suffix
// (e.g. /services/industriele-schilderwerken.html); the public URL never does.
const trimmed = rawPath.length > 1 ? rawPath.replace(/\.html$/, '').replace(/\/$/, '') : rawPath;

const isEN = trimmed === '/en' || trimmed.startsWith('/en/');
const isFR = trimmed === '/fr' || trimmed.startsWith('/fr/');
const locale: Locale = isEN ? 'EN' : isFR ? 'FR' : 'NL';
const basePath = (() => {
  for (const p of ['/en', '/fr']) {
    if (trimmed === p || trimmed === `${p}/`) return '/';
    if (trimmed.startsWith(`${p}/`)) return trimmed.slice(3);
  }
  return trimmed;
})();

const articleSlug = basePath.startsWith('/insights/') ? basePath.slice('/insights/'.length) : null;
const article = articleSlug ? findArticle(articleSlug) : null;

const meta = PAGE_META[basePath] ?? PAGE_META['/'];
const localeMeta = article
  ? { title: articleContent(article, locale).metaTitle, description: articleContent(article, locale).description, image: article.heroImage }
  : (meta[locale] ?? meta.NL);
const isNoindex = article ? false : !!meta.noindex;
const ogType = article ? 'article' : 'website';

const nlPath = basePath === '/' ? '/' : basePath;
const enPath = basePath === '/' ? '/en' : `/en${basePath}`;
const frPath = basePath === '/' ? '/fr' : `/fr${basePath}`;

const canonical = `${SITE_URL}${locale === 'EN' ? enPath : locale === 'FR' ? frPath : nlPath}`;
const nlUrl = `${SITE_URL}${nlPath}`;
const enUrl = `${SITE_URL}${enPath}`;
const frUrl = `${SITE_URL}${frPath}`;

const ogImage = `${SITE_URL}${localeMeta.image ?? DEFAULT_OG_IMAGE}`;
const htmlLang = { NL: 'nl', EN: 'en', FR: 'fr' }[locale];
const ogLocale = { NL: 'nl_BE', EN: 'en_BE', FR: 'fr_BE' }[locale];

const BREADCRUMB_LABELS: Record<string, Record<Locale, string>> = {
  '/':           { NL: 'Home',           EN: 'Home', FR: 'Accueil' },
  '/services':   { NL: 'Diensten',       EN: 'Services', FR: 'Services' },
  '/services/industriele-schilderwerken': { NL: 'Industriële schilderwerken', EN: 'Industrial painting', FR: 'Peinture industrielle' },
  '/services/tankcoating': { NL: 'Tankcoating & tank lining', EN: 'Tank coating & lining', FR: 'Revêtement de réservoirs' },
  '/services/industrieel-stralen': { NL: 'Industrieel stralen', EN: 'Industrial blasting', FR: 'Sablage industriel' },
  '/services/corrosiebescherming': { NL: 'Corrosiebescherming', EN: 'Corrosion protection', FR: 'Protection anticorrosion' },
  '/industries': { NL: 'Sectoren',       EN: 'Industries', FR: 'Secteurs' },
  '/projects':   { NL: 'Projecten',      EN: 'Projects', FR: 'Projets' },
  '/safety':     { NL: 'Veiligheid',     EN: 'Safety', FR: 'Sécurité' },
  '/about':      { NL: 'Over ons',       EN: 'About', FR: 'À propos' },
  '/contact':    { NL: 'Contact',        EN: 'Contact', FR: 'Contact' },
  '/insights':   { NL: 'Kenniscentrum',  EN: 'Insights', FR: 'Expertise' },
  '/privacy':    { NL: 'Privacy',        EN: 'Privacy', FR: 'Confidentialité' },
  '/terms':      { NL: 'Voorwaarden',    EN: 'Terms', FR: 'Conditions' },
};

const L = (path: string) => `${SITE_URL}${locale === 'EN' ? (path === '/' ? '/en' : `/en${path}`) : locale === 'FR' ? (path === '/' ? '/fr' : `/fr${path}`) : path}`;
const homeLabel = BREADCRUMB_LABELS['/'][locale];
const homeUrl = L('/');

const insightsLabel = BREADCRUMB_LABELS['/insights'][locale];
const insightsUrl = L('/insights');
const isServiceSub = basePath.startsWith('/services/');
const servicesLabel = BREADCRUMB_LABELS['/services'][locale];
const servicesUrl = L('/services');
const caseStudy = basePath.startsWith('/projects/') ? CASE_STUDIES.find((c) => `/projects/${c.slug}` === basePath) : null;
// A French version exists for every base page, and for articles and case studies once translated.
const hasFR = article ? !!article.FR : caseStudy ? !!caseStudy.FR : true;
const ogLocaleAlts = ['nl_BE', 'en_BE', ...(hasFR ? ['fr_BE'] : [])].filter((l) => l !== ogLocale);
const projectsLabel = BREADCRUMB_LABELS['/projects'][locale];
const projectsUrl = L('/projects');

const breadcrumbSchema = basePath === '/' ? null : article ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: insightsLabel, item: insightsUrl },
    { '@type': 'ListItem', position: 3, name: articleContent(article, locale).title, item: canonical },
  ],
} : caseStudy ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: projectsLabel, item: projectsUrl },
    { '@type': 'ListItem', position: 3, name: localeText(caseStudy.breadcrumb, locale), item: canonical },
  ],
} : isServiceSub ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: servicesLabel, item: servicesUrl },
    { '@type': 'ListItem', position: 3, name: BREADCRUMB_LABELS[basePath]?.[locale] ?? localeMeta.title, item: canonical },
  ],
} : {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: BREADCRUMB_LABELS[basePath]?.[locale] ?? localeMeta.title, item: canonical },
  ],
};

const websiteSchema = basePath === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Russo NV',
  alternateName: 'Russo Industriële Coatings',
  url: SITE_URL,
  inLanguage: ['nl-BE', 'fr-BE', 'en'],
  publisher: { '@id': `${SITE_URL}/#organization` },
} : null;

const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  headline: articleContent(article, locale).title,
  description: articleContent(article, locale).description,
  image: ogImage,
  datePublished: article.date,
  dateModified: article.updated ?? article.date,
  inLanguage: { NL: 'nl-BE', EN: 'en', FR: 'fr-BE' }[locale],
  author: {
    '@type': 'Person',
    name: article.author,
    ...(article.authorRole ? { jobTitle: localeText(article.authorRole, locale) } : {}),
    ...(article.authorImage ? { image: `${SITE_URL}${article.authorImage}` } : {}),
    worksFor: { '@type': 'Organization', name: 'Russo NV', url: SITE_URL },
    knowsAbout: ['Industrial coatings', 'Surface preparation', 'Abrasive blasting', 'Corrosion protection'],
    ...(article.authorUrl ? { sameAs: [article.authorUrl] } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Russo NV',
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/logo.png` },
  },
  keywords: localeText(article.keywords, locale).join(', '),
} : null;

// FAQ rich result: build FAQPage schema from the article's faq block (if any).
const faqItems = article
  ? (articleContent(article, locale).body.find((b) => b.type === 'faq') as Extract<ArticleBlock, { type: 'faq' }> | undefined)?.items
  : undefined;
const faqSchema = faqItems && faqItems.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
} : null;

// OG/Twitter image alt + dimensions (read real dims at build; degrade gracefully).
const ogImageAlt = article ? localeText(article.heroAlt, locale) : localeMeta.title;
let ogImageDims: { width: number; height: number } | null = null;
try {
  const sharp = (await import('sharp')).default;
  const rel = (localeMeta.image ?? DEFAULT_OG_IMAGE).replace(/^\//, '');
  const md = await sharp(`public/${rel}`).metadata();
  if (md.width && md.height) ogImageDims = { width: md.width, height: md.height };
} catch {}
---

<html lang={htmlLang} class="w-full h-full">
  <head>
    <Head />
    <title>{localeMeta.title}</title>
    <meta name="description" content={localeMeta.description} />
    {/* Trustpilot one-time domain verification (2026-09-08); safe to remove after the claim is confirmed. */}
    <meta name="trustpilot-one-time-domain-verification-id" content="c6697447-7f04-44bf-be21-4636156d0443" />
    {/* LCP: fetch this route's hero image at highest priority, before the
        browser discovers it inside the rendered body. */}
    {(localeMeta.heroImage ?? localeMeta.image) && (
      <link rel="preload" as="image" href={localeMeta.heroImage ?? localeMeta.image} fetchpriority="high" />
    )}
    <link rel="canonical" href={canonical} />
    {isNoindex && <meta name="robots" content="noindex, follow" />}

    <link rel="alternate" hreflang="nl-be" href={nlUrl} />
    <link rel="alternate" hreflang="nl" href={nlUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    {hasFR && <link rel="alternate" hreflang="fr-be" href={frUrl} />}
    {hasFR && <link rel="alternate" hreflang="fr" href={frUrl} />}
    <link rel="alternate" hreflang="x-default" href={nlUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Russo NV" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlts.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={localeMeta.title} />
    <meta property="og:description" content={localeMeta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageDims && <meta property="og:image:width" content={String(ogImageDims.width)} />}
    {ogImageDims && <meta property="og:image:height" content={String(ogImageDims.height)} />}
    {article && <meta property="article:published_time" content={article.date} />}
    {article && <meta property="article:modified_time" content={article.updated ?? article.date} />}
    {article && <meta property="article:section" content={articleContent(article, locale).category} />}
    {article && localeText(article.keywords, locale).map((k) => <meta property="article:tag" content={k} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={localeMeta.title} />
    <meta name="twitter:description" content={localeMeta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {(article || basePath === '/insights') && (
      <link rel="alternate" type="application/rss+xml" title="Russo NV Kenniscentrum" href={`${SITE_URL}/insights/rss.xml`} />
    )}

    {breadcrumbSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(breadcrumbSchema)}
      />
    )}
    {websiteSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(websiteSchema)}
      />
    )}
    {articleSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(articleSchema)}
      />
    )}
    {faqSchema && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(faqSchema)}
      />
    )}
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:load initialPath={trimmed} />
    </div>
  </body>
</html>
